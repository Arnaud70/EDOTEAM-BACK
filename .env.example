# Base de données
# Neon : DATABASE_URL = endpoint -pooler + &pgbouncer=true ; DIRECT_URL = endpoint SANS -pooler (migrations).
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/db?sslmode=require"

# Ping périodique de la base pour éviter la mise en veille Neon (ms). 0 = désactivé. Défaut 240000.
DB_KEEPALIVE_MS=240000

# Durée de validité du code OTP email (secondes, entre 30 et 600, défaut 120).
OTP_TTL_SECONDS=120
# Verrouillage : X échecs cumulés -> blocage de Y minutes (défauts 8 / 60).
OTP_MAX_FAILED_ATTEMPTS=8
OTP_LOCK_MINUTES=60

# Cache : laisser REDIS_URL vide = cache mémoire. Sinon Redis (recommandé en prod).
# Upstash (gratuit) : rediss://default:<password>@<region>.upstash.io:6379
REDIS_URL=""
CACHE_TTL_MS=300000

# Auth / JWT — OBLIGATOIRES, min 32 caractères, valeurs distinctes.
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
JWT_REFRESH_SECRET=""

# SMTP (optionnel — sans ça, les e-mails sont simplement ignorés)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM_NAME="EDOTEAM"
MAIL_FROM_EMAIL=""

# Google OAuth (optionnel)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"

# URLs
FRONTEND_URL="http://localhost:5173"
BACKEND_URL="http://localhost:3000"
PORT=3000

# Divers
# NODE_ENV=production      # IMPORTANT en prod : cookies sécurisés, Swagger off, pas de log des codes OTP
# ENABLE_SWAGGER=false
# CORS_ORIGINS="https://mon-front.vercel.app,https://autre-domaine.com"

# Vérification email + mot de passe oublié : nécessitent une config SMTP valide ci-dessus.
# Sans SMTP, les comptes sont activés automatiquement à l'inscription (mode dev).
